    <view class="LedThreeWaySwitch" origin="761, 478" size="50, 52" control-tag="Shift" tooltip="Tape emphasis / voicing" />
    <view class="CTextLabel" origin="750, 538" size="72, 19" control-tag="Shift" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="835, 455" size="84, 18" title="MASTER" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="BypassButton" origin="845, 473" size="64, 68" control-tag="Bypass" tooltip="Bypass the complete Tape Drive" />

    <view class="CTextLabel" origin="919, 455" size="88, 18" title="UI SCALE" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="CTextButton" origin="918, 479" size="42, 23" title="70%" font="Small" control-tag="Zoom75" text-color="Cream" text-color-highlighted="Amber" frame-color="Border" frame-width="1" round-radius="4" kick-style="true" transparent="true" tooltip="GUI scale 70%" />
    <view class="CTextButton" origin="965, 479" size="42, 23" title="85%" font="Small" control-tag="Zoom100" text-color="Cream" text-color-highlighted="Amber" frame-color="Border" frame-width="1" round-radius="4" kick-style="true" transparent="true" tooltip="GUI scale 85%" />
    <view class="CTextButton" origin="918, 508" size="42, 23" title="100%" font="Small" control-tag="Zoom125" text-color="Cream" text-color-highlighted="Amber" frame-color="Border" frame-width="1" round-radius="4" kick-style="true" transparent="true" tooltip="GUI scale 100%" />
    <view class="CTextButton" origin="965, 508" size="42, 23" title="125%" font="Small" control-tag="Zoom150" text-color="Cream" text-color-highlighted="Amber" frame-color="Border" frame-width="1" round-radius="4" kick-style="true" transparent="true" tooltip="GUI scale 125%" />

    <view class="CTextLabel" origin="42, 585" size="965, 24" title="Right-click any knob or switch to return it to the default value  •  Vector rendering  •  Host automation / FL Studio ready" font="Small" font-color="Muted" transparent="true" text-alignment="left" mouse-enabled="false" />
