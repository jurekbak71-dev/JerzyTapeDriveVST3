<?xml version='1.0' encoding='UTF-8'?>
<vstgui-ui-description version="1">
  <fonts>
    <font name="Title" font-name="Arial" size="25" bold="true" />
    <font name="Section" font-name="Arial" size="15" bold="true" />
    <font name="Label" font-name="Arial" size="14" bold="true" />
    <font name="Small" font-name="Arial" size="10" bold="true" />
    <font name="Value" font-name="Arial" size="12" bold="true" />
  </fonts>
  <colors>
    <color name="Amber" rgba="#f0ae58ff" />
    <color name="Cream" rgba="#eee0c5ff" />
    <color name="Black" rgba="#111417ff" />
    <color name="ValueBack" rgba="#0b161bda" />
    <color name="Border" rgba="#8ca4a6d0" />
    <color name="Muted" rgba="#9eb7b9ff" />
  </colors>
  <template name="view" class="CViewContainer" origin="0, 0" size="1040, 640" minSize="728, 448" maxSize="1560, 960" transparent="false" tooltip="Jerzy Tape Drive">
    <view class="OxidizedPanel" origin="0, 0" size="1040, 640" mouse-enabled="false" />
    <view class="HardwarePanel" origin="0, 0" size="1040, 640" mouse-enabled="false" />

    <view class="CTextLabel" origin="34, 20" size="470, 36" title="JERZY TAPE DRIVE" font="Title" font-color="Cream" transparent="true" text-alignment="left" mouse-enabled="false" />
    <view class="CTextLabel" origin="665, 24" size="340, 24" title="VECTOR 1.2  •  DEEP TAPE / OPTO" font="Small" font-color="Amber" transparent="true" text-alignment="right" mouse-enabled="false" />

    <view class="CTextLabel" origin="42, 78" size="530, 22" title="TAPE / TRANSPORT" font="Section" font-color="Amber" transparent="true" text-alignment="left" mouse-enabled="false" />
    <view class="CTextLabel" origin="625, 78" size="350, 22" title="METERS / OPTICAL INPUT COMPRESSOR" font="Section" font-color="Amber" transparent="true" text-alignment="left" mouse-enabled="false" />

    <view class="CTextLabel" origin="56, 108" size="126, 20" title="DRIVE" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="68, 130" size="102, 102" control-tag="Sat" wheel-inc-value="0.01" tooltip="Tape saturation and magnetic drive" />
    <view class="CTextLabel" origin="82, 234" size="74, 20" control-tag="Sat" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="230, 108" size="126, 20" title="OUTPUT" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="242, 130" size="102, 102" control-tag="Level" wheel-inc-value="0.01" tooltip="Processed output level" />
    <view class="CTextLabel" origin="256, 234" size="74, 20" control-tag="Level" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="404, 108" size="126, 20" title="DRY" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="416, 130" size="102, 102" control-tag="Dry" wheel-inc-value="0.01" tooltip="Add original signal in parallel" />
    <view class="CTextLabel" origin="430, 234" size="74, 20" control-tag="Dry" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="59, 267" size="118, 18" title="WOW" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="75, 287" size="86, 86" control-tag="Wow" wheel-inc-value="0.01" tooltip="Slow reel/capstan drift plus random transport movement" />
    <view class="CTextLabel" origin="82, 375" size="72, 20" control-tag="Wow" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="234, 267" size="118, 18" title="FLUTTER" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="250, 287" size="86, 86" control-tag="Flutter" wheel-inc-value="0.01" tooltip="Fast capstan jitter with correlated irregularity" />
    <view class="CTextLabel" origin="257, 375" size="72, 20" control-tag="Flutter" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="409, 267" size="118, 18" title="TAPE AGE" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="425, 287" size="86, 86" control-tag="Age" wheel-inc-value="0.01" tooltip="Wear: scrape flutter, HF loss, dropouts, slips, hiss, crackle and thumps" />
    <view class="CTextLabel" origin="432, 375" size="72, 20" control-tag="Age" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="618, 107" size="176, 18" title="INPUT" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="AnalogMeter" origin="618, 129" size="176, 88" control-tag="InputMeter" mouse-enabled="false" />
    <view class="CTextLabel" origin="815, 107" size="176, 18" title="OUTPUT" font="Label" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="AnalogMeter" origin="815, 129" size="176, 88" control-tag="OutputMeter" mouse-enabled="false" />

    <view class="CTextLabel" origin="620, 239" size="110, 18" title="COMPRESSION" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="633, 258" size="84, 84" control-tag="OptoAmount" wheel-inc-value="0.01" tooltip="Program-dependent optical gain reduction; deeper settings also drive the color stage" />
    <view class="CTextLabel" origin="639, 344" size="72, 20" control-tag="OptoAmount" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="746, 239" size="110, 18" title="MAKEUP" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="759, 258" size="84, 84" control-tag="OptoMakeup" wheel-inc-value="0.01" tooltip="Optical compressor output amplifier gain" />
    <view class="CTextLabel" origin="765, 344" size="72, 20" control-tag="OptoMakeup" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="875, 239" size="82, 18" title="BYPASS" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="BypassButton" origin="884, 264" size="64, 68" control-tag="OptoBypass" tooltip="Bypass optical cell and its tube/transformer colour" />
    <view class="CTextLabel" origin="956, 249" size="42, 18" title="GR" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="CTextLabel" origin="952, 273" size="50, 22" control-tag="OptoGR" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />
    <view class="CTextLabel" origin="860, 348" size="138, 36" title="T4-style memory\n+ coloured output amp" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />

    <view class="CTextLabel" origin="42, 420" size="950, 22" title="TONE / PREAMP / MASTER" font="Section" font-color="Amber" transparent="true" text-alignment="left" mouse-enabled="false" />

    <view class="CTextLabel" origin="42, 455" size="82, 18" title="HPF Hz" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="53, 475" size="60, 60" control-tag="HPF" wheel-inc-value="0.01" tooltip="High-pass filter frequency" />
    <view class="CTextLabel" origin="47, 538" size="72, 19" control-tag="HPF" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="137, 455" size="82, 18" title="HPF Q" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
