    <view class="CTextLabel" origin="142, 538" size="72, 19" control-tag="HPFRes" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="232, 455" size="82, 18" title="LPF Hz" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="243, 475" size="60, 60" control-tag="LPF" wheel-inc-value="0.01" tooltip="Low-pass filter frequency" />
    <view class="CTextLabel" origin="237, 538" size="72, 19" control-tag="LPF" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="327, 455" size="82, 18" title="LPF Q" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="338, 475" size="60, 60" control-tag="LPFRes" wheel-inc-value="0.01" tooltip="Low-pass resonance" />
    <view class="CTextLabel" origin="332, 538" size="72, 19" control-tag="LPFRes" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="438, 455" size="100, 18" title="PREAMP DRIVE" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="ChickenKnob" origin="458, 469" size="60, 60" control-tag="PreampDrive" wheel-inc-value="0.01" tooltip="Preamp saturation amount" />
    <view class="CTextLabel" origin="452, 538" size="72, 19" control-tag="PreampDrive" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="555, 455" size="88, 18" title="PREAMP" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
    <view class="LedThreeWaySwitch" origin="574, 478" size="50, 52" control-tag="PreampMode" tooltip="OFF / TUBE / TRANSISTOR" />
    <view class="CTextLabel" origin="547, 538" size="104, 19" control-tag="PreampMode" font="Value" font-color="Amber" back-color="ValueBack" frame-color="Border" frame-width="1" text-alignment="center" transparent="false" mouse-enabled="false" />

    <view class="CTextLabel" origin="662, 455" size="72, 18" title="GAIN" font="Small" font-color="Muted" transparent="true" text-alignment="center" mouse-enabled="false" />
