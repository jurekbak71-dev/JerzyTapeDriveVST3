<?xml version='1.0' encoding='UTF-8'?>
<vstgui-ui-description version="1">
  <fonts>
    <font name="Label" font-name="Arial" size="18" bold="true" />
    <font name="Small" font-name="Arial" size="12" bold="true" />
    <font name="Value" font-name="Arial" size="15" bold="true" />
  </fonts>
  <colors>
    <color name="Amber" rgba="#e6a04eff" />
    <color name="Cream" rgba="#ecd9b5ff" />
    <color name="Black" rgba="#0f0e0cff" />
    <color name="Border" rgba="#856f50ff" />
  </colors>
  <bitmaps>
    <bitmap name="VintagePanel" path="tapedrive_vintage_background.jpg" />
  </bitmaps>
